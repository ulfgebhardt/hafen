{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hafen",
  "version": "0.0.0",
  "identifier": "dev.ulf-gebhardt.hafen",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Hafen",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Übersicht über alle Git-Repos einer Maschine",
    "longDescription": "Der Hafen misst alle Git-Repositories einer Maschine und zeichnet sie als Flotte: Liegezeit, Test-Vertrag und was die Flotte an Forderungen stellt — mit der Evidenz hinter jedem Urteil. Er misst und zeichnet, er tut nichts.",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [
        "https://github.com/ulfgebhardt/hafen/releases/latest/download/latest.json"
      ],
      "pubkey": "HIER-DEN-OEFFENTLICHEN-SCHLUESSEL-EINSETZEN"
    }
  }
}
