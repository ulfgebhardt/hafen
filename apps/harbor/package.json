{
  "name": "@hafen/harbor",
  "version": "1.3.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "snapshot": "pnpm --filter @hafen/cli exec tsx src/index.ts schnappschuss > public/snapshot.json",
    "test:lint": "eslint --max-warnings 0 .",
    "test:lint:typecheck": "vue-tsc --noEmit",
    "test:unit": "vitest run --coverage",
    "test:e2e": "playwright test",
    "tauri": "tauri",
    "app": "tauri dev",
    "app:build": "tauri build",
    "measure": "mkdir -p \"${XDG_CACHE_HOME:-$HOME/.cache}/hafen\" && pnpm --filter @hafen/cli exec tsx src/index.ts schnappschuss > \"${XDG_CACHE_HOME:-$HOME/.cache}/hafen/snapshot.json\""
  },
  "dependencies": {
    "@hafen/core": "workspace:*",
    "pixi.js": "^8.21.0",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.7",
    "@vue/test-utils": "^2.4.10",
    "happy-dom": "^20.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.7.2",
    "vite": "^7.1.14",
    "vitest": "^4.1.7",
    "vue-tsc": "^3.1.2"
  }
}
