node_modules/
dist/
coverage/
.turbo/
*.tsbuildinfo
# Measured, not authored: `pnpm --filter @hafen/harbor snapshot` writes it, and it carries every
# local path on this machine.
apps/harbor/public/snapshot.json

# The same, for the forge reading: `hafen forge` writes it, and it names every repository this
# machine has an origin for — including the private ones it could not read.
apps/harbor/public/forge.json

# Cargo build output.
/target/
# Generated by tauri-build on every build from `capabilities/`.
/apps/harbor/src-tauri/gen/

# Niemals ein Signaturschlüssel im Baum. Beide liegen in ~/.tauri und sollen dort bleiben; diese
# Zeilen sind die Versicherung gegen die Kopie, die jemand "nur kurz" hierher legt, und gegen das
# `git add .` danach. Ein veröffentlichter privater Schlüssel lässt sich nicht zurückziehen --
# jeder, der ihn hat, signiert Updates, die jedes installierte Fenster annimmt.
*.key
